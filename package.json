{
  "name": "gyeongmin-dispatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "sync:functions": "node scripts/sync-functions.mjs",
    "seed:sql": "node --experimental-strip-types scripts/gen-seed-sql.ts > supabase/seed.sql",
    "setup:sql": "node scripts/gen-setup-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "browser-image-compression": "^2.0.2",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "html-to-image": "1.11.11",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
